# Copy to .env (repository root, gitignored) and fill in your own values.
# Used by:
#   - deploy/windows/start-astrbot.ps1, start-snowluma.ps1
#   - scripts/configure_snowluma.py, bootstrap_astrbot_config.py, healthcheck.py

# --- LLM providers (at least one) ---
# Referenced from data/cmd_config.json as $DEEPSEEK_API_KEY (never stored there).
DEEPSEEK_API_KEY=

# Custom OpenAI-compatible aggregator (optional, see scripts/bootstrap_astrbot_config.py).
# MULTI_API_BASE defaults to the value in the bootstrap script if omitted.
# MULTI_API_KEY=
# MULTI_API_BASE=

# Optional additional OpenAI-compatible providers: add the matching provider
# source in the AstrBot WebUI, then reference the key with $VAR in its config.
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=

# --- SnowLuma (QQ protocol side) ---
# Install dir; defaults to C:\SnowLuma.
# SNOWLUMA_HOME=C:\SnowLuma
# Generated by scripts/configure_snowluma.py when empty.
ONEBOT_WS_TOKEN=
SNOWLUMA_HTTP_TOKEN=
