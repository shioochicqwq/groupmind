# Copy to .env (repository root, gitignored) and fill in your own values.
# Used by:
#   - deploy/windows/start-astrbot.ps1 (local dev)
#   - docker compose (VPS production, project root .env is auto-loaded)

# --- LLM providers (at least one) ---
# Referenced from data/cmd_config.json as $DEEPSEEK_API_KEY (never stored there).
DEEPSEEK_API_KEY=

# Optional additional OpenAI-compatible providers: add the matching provider
# source in the AstrBot WebUI, then reference the key with $VAR in its config.
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=

# --- Linux VPS only ---
# NapCat WebUI token: use a long random string, e.g. `openssl rand -hex 16`.
NAPCAT_WEBUI_TOKEN=
# UID/GID that own runtime/napcat and runtime/ntqq (default 1000 on most VPS).
NAPCAT_UID=1000
NAPCAT_GID=1000
