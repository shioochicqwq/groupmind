# Copy to .env and fill in what you have. Loaded by deploy/windows/start-astrbot.ps1
# and by the Linux/systemd launcher.

# --- LLM providers (at least one) ---
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: additional OpenAI-compatible provider, e.g. SiliconFlow / OpenRouter /
# Moonshot / Zhipu. Add the matching provider source in the AstrBot WebUI
# ("模型提供商" page) and it will appear for /provider and /model commands.
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
